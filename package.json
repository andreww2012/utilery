    "./predicate": "./dist/predicate/index.mjs",
    "./regex": "./dist/regex/index.mjs",
    "./runtime": "./dist/runtime/index.mjs",
    "./semver": "./dist/semver/index.mjs",
    "./server": "./dist/server/index.mjs",
    "./set": "./dist/set/index.mjs",
    "./string": "./dist/string/index.mjs",
