    },
    "./iterable": {
      "types": "./dist/iterable/index.d.mts",
      "default": "./dist/iterable/index.mjs"
    },
    "./json": {
      "types": "./dist/json/index.d.mts",
      "default": "./dist/json/index.mjs"
    },
