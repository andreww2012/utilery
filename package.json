    "npm-check-updates": "23.1.0",
    "oxfmt": "catalog:format",
    "path-type": "6.0.0",
    "picomatch": "4.0.7",
    "pretty-ms": "9.3.1",
    "publint": "0.3.25",
    "puka": "1.0.1",
    "range-parser": "1.3.0",
    "remeda": "2.51.0",
    "rolldown": "1.2.13",
    "safe-stable-stringify": "2.5.0",
    "split-string": "6.1.0",
    "string-ts": "2.3.1",
    "string-width": "8.3.0",
    "strip-ansi": "7.2.0",
    "ts-extras": "1.3.0",
    "tsdown": "0.23.1",
    "type-fest": "5.10.0",
    "typed-query-selector": "2.12.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript7": "npm:typescript@7.0.2",
    "uint8array-extras": "1.6.0",
    "valibot": "1.5.0",
