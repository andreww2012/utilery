    "@vitest/eslint-plugin": "1.6.27",
    "@vitest/ui": "5.0.3",
    "actions-up": "1.21.0",
    "all-contributors-cli": "6.27.0-rc.1",
    "any-ascii": "0.3.3",
    "arkregex": "0.0.12",
    "cleye": "2.7.0",
    "clickable-path": "0.1.1",
