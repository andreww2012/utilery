      "default": "./dist/value/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "count-exports": "node scripts/count-exports.ts",
    "contrib:add": "all-contributors add",
    "contrib:gen": "all-contributors generate",

    "u": "ncu",
    "u:m": "ncu -t minor",
    "u:pm": "pnpm self-update",
    "u:actions": "actions-up",
    "deps:audit": "pnpm audit --audit-level high",
    "deps:audit:fix": "nr deps:audit --fix override",
    "deps:audit:fix:update": "nr deps:audit --fix update",
    "check:deps:dedupe": "pnpm dedupe --check",
    "check:deps:peers": "pnpm peers check",
    "check:spelling": "cspell --no-progress --no-summary .",
    "check:format": "oxfmt --check",
    "format": "oxfmt",
    "eslint:inspect": "eslint-config-inspector --open false",
    "eslint": "cross-env NODE_OPTIONS='--max-old-space-size=6144' eslint --cache",
    "ts": "tsc --build test/tsconfig.json",
    "ts6": "tsc6 --build test/tsconfig.json",
    "knip:main": "knip --no-progress",
    "knip:cycles": "knip --no-progress --cycles --reporter cycles",
    "knip": "nr \"/^knip:.+$/\"",
    "check": "nr \"/^(knip|check:(spelling|format)|ts|eslint)$/\"",
    "check:deps": "nr \"/^(deps:audit|check:deps:peers)$/\"",
    "check:deps:strict": "nr \"/^(deps:audit|check:deps:(dedupe|peers))$/\"",
    "check:fix": "nr format && nr eslint --fix && nr format",
    "t": "vitest",
    "t:ui": "vitest --ui",
    "t:cov": "vitest --coverage",
    "test:vitest": "nr t run",
    "test:vitest:cov": "nr t:cov run",
    "test:types:consumer": "vitest run --config test/published-dts/vitest.config.ts",
    "test:side-effects": "vitest run --config test/published-side-effects/vitest.config.ts",
    "test": "nr check:deps && nr check && nr build && nr test:types:consumer && nr test:side-effects && nr test:vitest:cov",
    "ch": "changeset add --message \"___REPLACE_ME___\"",
    "release": "changeset publish",
    "build": "tsdown --clean",
    "build:test": "tsdown --out-dir temp/dist",
    "prepublishOnly": "nr build && node scripts/generate-third-party-notices.ts"
  },
  "devDependencies": {
    "@antfu/ni": "30.6.0",
    "@antfu/utils": "9.3.0",
    "@arethetypeswrong/core": "0.18.5",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@commitlint/types": "21.2.3",
    "@eslint/config-inspector": "3.5.0",
    "@sindresorhus/slugify": "3.0.1",
    "@sindresorhus/transliterate": "2.3.1",
    "@thi.ng/binary": "3.6.17",
    "@tusbar/cache-control": "3.0.1",
