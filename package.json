    },
    "./path": {
      "types": "./dist/path/index.d.mts",
      "default": "./dist/path/index.mjs"
    },
    "./predicate": {
      "types": "./dist/predicate/index.d.mts",
      "default": "./dist/predicate/index.mjs"
    },
    "./regex": {
      "types": "./dist/regex/index.d.mts",
