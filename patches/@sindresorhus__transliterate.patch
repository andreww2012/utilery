Builds the replacement pattern on the first call that needs it instead of on import. Building it
takes ~3 ms, which every import of `utilery` and `utilery/string` paid, even when `slugify` is never
called.

Also lists the keys of the replacements without `Iterator#toArray`, which is not a "Baseline Widely
Available" feature yet.

diff --git a/index.js b/index.js
index 7019877..3a6d45f 100644
--- a/index.js
+++ b/index.js
@@ -6,12 +6,13 @@ const escapeRegex = string => string.replaceAll(/[$\(\)*+.?\[\\\]^\{\|\}]/gv, St
 
 const buildReplacementPattern = replacements => {
 	// Sort by key length descending so longer patterns match first (e.g., 'ու' before 'ո')
-	const sortedKeys = replacements.keys().toArray().toSorted((a, b) => b.length - a.length);
+	const sortedKeys = [...replacements.keys()].toSorted((a, b) => b.length - a.length);
 	return new RegExp(sortedKeys.map(key => escapeRegex(key)).join('|'), 'gv');
 };
 
-// A locale only changes the value of keys that are already in the built-in table, so every locale matches the same characters and can share one pre-compiled pattern. Only the replacement values differ.
-const pattern = buildReplacementPattern(builtinReplacements);
+// A locale only changes the value of keys that are already in the built-in table, so every locale matches the same characters and can share one pattern. Only the replacement values differ.
+// The pattern is built on first use and then reused: building it takes ~3 ms, which every import would pay
+let pattern;
 
 const defaultLocaleData = {
 	replacements: builtinReplacements,
@@ -72,7 +73,7 @@ export default function transliterate(string, options) {
 
 	const {replacements, contextReplacements} = getLocaleData(normalizeLocale(options?.locale));
 
-	const applyReplacements = input => input.replace(pattern, match => replacements.get(match));
+	const applyReplacements = input => input.replace(pattern ??= buildReplacementPattern(builtinReplacements), match => replacements.get(match));
 
