 			// Continuation byte or invalid lead byte — emit one `%XX` literally.
 			if (sequenceLength === 0) {
-				const pair = input.slice(position, position + 6);
+				const pair = input.slice(position, position + 6).toUpperCase();
 
-				// UTF-16 BOM byte pairs become two replacement characters.
+				// UTF-16 BOM byte pairs, in any case, become two replacement characters.
 				if (pair === '%FE%FF' || pair === '%FF%FE') {
 					output += '\uFFFD\uFFFD';
 					position += 6;
@@ -122,8 +122,8 @@ function decode(input) {
