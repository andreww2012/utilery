+// Sets `object[key]` as an own property: assigning a `__proto__` key would replace the prototype
+function setOwnValue( object, key, value ) {
+  if( key === '__proto__' ) {
+    Object.defineProperty( object, key, { value: value, writable: true, enumerable: true, configurable: true })
+  } else {
+    object[ key ] = value
+  }
+}
