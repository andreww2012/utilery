Moves the range name types (`IPv4Range` and `IPv6Range`) into a separate ES module declaration file,
`lib/ranges.d.ts`, so that our `getIpRange` can reuse them: the package declares them inside an
ambient `declare module` ending with `export =`, which neither exports them nor lets our declaration
build inline them.

diff --git a/lib/ipaddr.d.ts b/lib/ipaddr.d.ts
index ee02c024997a8e4267fb5d6ecc13f217b8676ea5..70c61d829809d8a04f610cf20d4a2286c8808213 100644
--- a/lib/ipaddr.d.ts
+++ b/lib/ipaddr.d.ts
@@ -1,7 +1,6 @@
 declare module "ipaddr.js" {
-    type IPvXRangeDefaults = 'unicast' | 'unspecified' | 'multicast' | 'linkLocal' | 'loopback' | 'reserved' | 'benchmarking' | 'amt';
-    type IPv4Range = IPvXRangeDefaults | 'broadcast' | 'carrierGradeNat' | 'private' | 'as112';
-    type IPv6Range = IPvXRangeDefaults | 'uniqueLocal' | 'ipv4Mapped' | 'rfc6145' | 'rfc6052' | '6to4' | 'teredo' | 'as112v6' | 'orchid2' | 'droneRemoteIdProtocolEntityTags';
+    type IPv4Range = import('ipaddr.js/lib/ranges').IPv4Range;
+    type IPv6Range = import('ipaddr.js/lib/ranges').IPv6Range;
 
     interface RangeList<T> {
         [name: string]: [T, number] | [T, number][];
diff --git a/lib/ranges.d.ts b/lib/ranges.d.ts
new file mode 100644
index 0000000000000000000000000000000000000000..fabbfa8f4f27fdf19c015311825472016ee54686
--- /dev/null
+++ b/lib/ranges.d.ts
@@ -0,0 +1,3 @@
+export type IPvXRangeDefaults = 'unicast' | 'unspecified' | 'multicast' | 'linkLocal' | 'loopback' | 'reserved' | 'benchmarking' | 'amt';
+export type IPv4Range = IPvXRangeDefaults | 'broadcast' | 'carrierGradeNat' | 'private' | 'as112';
+export type IPv6Range = IPvXRangeDefaults | 'uniqueLocal' | 'ipv4Mapped' | 'rfc6145' | 'rfc6052' | '6to4' | 'teredo' | 'as112v6' | 'orchid2' | 'droneRemoteIdProtocolEntityTags';
