--- a/dist/index.js
+++ b/dist/index.js
@@ -167,12 +167,26 @@ function camelCase(str) {
 }
 var toCamelCase = camelCase;
 
+// Sets `object[key]` as an own property: assigning a `__proto__` key would replace the prototype.
+// The key is converted like a property access does first, since `["__proto__"]` accesses
+// `__proto__` too
+function setOwnValue(object, key, value) {
+  if (typeof key === "object" && key !== null || typeof key === "function") {
+    key = Reflect.ownKeys({ [key]: void 0 })[0];
+  }
+  if (key === "__proto__") {
+    Object.defineProperty(object, key, { value, writable: true, enumerable: true, configurable: true });
+  } else {
+    object[key] = value;
+  }
+}
+
 // src/utils/object-keys/transform-keys.ts
 function transformKeys(obj, transform) {
   if (typeOf(obj) !== "object") return obj;
   const res = {};
   for (const key in obj) {
-    res[transform(key)] = obj[key];
+    setOwnValue(res, transform(key), obj[key]);
   }
   return res;
 }
@@ -207,7 +221,7 @@ function deepTransformKeys(obj, transform) {
   }
   const res = {};
   for (const key in obj) {
-    res[transform(key)] = deepTransformKeys(obj[key], transform);
+    setOwnValue(res, transform(key), deepTransformKeys(obj[key], transform));
   }
   return res;
 }
